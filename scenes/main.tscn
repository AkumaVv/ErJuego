[node name="Center" type="CenterContainer" parent="InventoryWindow/Panel/VBox/BackpackScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Grid" type="GridContainer" parent="InventoryWindow/Panel/VBox/BackpackScroll/Center"]
layout_mode = 2
theme_override_constants/h_separation = 5
theme_override_constants/v_separation = 5
columns = 10

[node name="CharacterWindow" type="CanvasLayer" parent="."]
visible = false
layer = 15

[node name="Shade" type="ColorRect" parent="CharacterWindow"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.015, 0.008, 0.005, 0)

[node name="Panel" type="PanelContainer" parent="CharacterWindow"]
anchor_right = 0.333333
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 16.0
offset_right = 0.0
offset_bottom = -16.0
theme_override_styles/panel = SubResource("Gothic_panel_style")

[node name="VBox" type="VBoxContainer" parent="CharacterWindow/Panel"]
theme_override_constants/separation = 20
alignment = 1

[node name="Title" type="Label" parent="CharacterWindow/Panel/VBox"]
text = "◆  CHARACTER  ◆"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.86, 0.66, 0.25, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_font_sizes/font_size = 31

[node name="Hint" type="Label" parent="CharacterWindow/Panel/VBox"]
text = "Press C or Escape to close"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.62, 0.51, 0.34, 1)

[node name="Separator" type="HSeparator" parent="CharacterWindow/Panel/VBox"]
theme_override_styles/separator = SubResource("Gothic_separator_style")

[node name="DetailsMargin" type="MarginContainer" parent="CharacterWindow/Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 10

[node name="Details" type="Label" parent="CharacterWindow/Panel/VBox/DetailsMargin"]
custom_minimum_size = Vector2(0, 390)
layout_mode = 2
text = "Name:\n\nClass:\n\nHealth:\n\nBase damage:\n\nSecondary:"
vertical_alignment = 1
theme_override_colors/font_color = Color(0.88, 0.79, 0.61, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 20

[connection signal="pressed" from="MultiplayerMenu/MenuPanel/VBox/Host" to="." method="_on_host_pressed"]
[connection signal="pressed" from="MultiplayerMenu/MenuPanel/VBox/Join" to="." method="_on_join_pressed"]
[connection signal="pressed" from="PauseMenu/Panel/VBox/Login" to="." method="_on_login_pressed"]
[connection signal="pressed" from="PauseMenu/Panel/VBox/ReturnToLobby" to="." method="_on_return_to_lobby_pressed"]
[connection signal="pressed" from="PauseMenu/Panel/VBox/Exit" to="." method="_on_exit_pressed"]
[connection signal="pressed" from="DeathMenu/Panel/VBox/ReturnToInsideLobby" to="." method="_on_death_return_inside_pressed"]
[connection signal="pressed" from="DeathMenu/Panel/VBox/ExitToMainLobby" to="." method="_on_death_exit_pressed"]
